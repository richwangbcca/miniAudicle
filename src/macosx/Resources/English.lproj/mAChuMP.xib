<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="15702" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment version="1090" identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="15702"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="mAChuMPWindowController">
            <connections>
                <outlet property="_tableView"             destination="10" id="20"/>
                <outlet property="_searchField"           destination="30" id="21"/>
                <outlet property="_actionButton"          destination="40" id="22"/>
                <outlet property="_progressIndicator"     destination="50" id="23"/>
                <outlet property="_statusLabel"           destination="60" id="24"/>
                <outlet property="window"                 destination="1"  id="25"/>
                <outlet property="_detailTextView"        destination="82" id="87"/>
                <outlet property="_installedOnlyCheckbox" destination="85" id="88"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application"/>
        <window title="ChuMP — ChucK Package Manager"
                allowsToolTipsWhenApplicationIsInactive="NO"
                autorecalculatesKeyViewLoop="NO"
                restorable="NO"
                releasedWhenClosed="NO"
                visibleAtLaunch="NO"
                animationBehavior="default"
                id="1">
            <windowStyleMask key="styleMask" titled="YES" closable="YES" miniaturizable="YES" resizable="YES"/>
            <windowPositionMask key="initialPositionMask" leftStrut="YES" topStrut="YES"/>
            <rect key="contentRect" x="80" y="200" width="780" height="540"/>
            <rect key="screenRect" x="0.0" y="0.0" width="1440" height="877"/>
            <view key="contentView" id="2">
                <rect key="frame" x="0.0" y="0.0" width="780" height="540"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>

                    <!-- Search field -->
                    <searchField verticalHuggingPriority="750" fixedFrame="YES"
                                 translatesAutoresizingMaskIntoConstraints="NO" id="30">
                        <rect key="frame" x="16" y="508" width="530" height="22"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                        <searchFieldCell key="cell" scrollable="YES" lineBreakMode="clipping"
                                         sendsActionOnEndEditing="YES"
                                         placeholderString="Search packages…" id="31">
                            <font key="font" metaFont="system"/>
                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                        </searchFieldCell>
                        <connections>
                            <action selector="search:" target="-2" id="32"/>
                        </connections>
                    </searchField>

                    <!-- "Installed only" checkbox -->
                    <button verticalHuggingPriority="750" fixedFrame="YES"
                            translatesAutoresizingMaskIntoConstraints="NO" id="85">
                        <rect key="frame" x="554" y="510" width="110" height="18"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="check" title="Installed only"
                                    bezelStyle="regularSquare" imagePosition="left"
                                    alignment="left" inset="2" id="86">
                            <behavior key="behavior" changeContents="YES" doesNotDimImage="YES"
                                      lightByContents="YES"/>
                            <font key="font" metaFont="smallSystem"/>
                        </buttonCell>
                        <connections>
                            <action selector="showInstalledOnly:" target="-2" id="89"/>
                        </connections>
                    </button>

                    <!-- Reload button -->
                    <button verticalHuggingPriority="750" fixedFrame="YES"
                            translatesAutoresizingMaskIntoConstraints="NO" id="70">
                        <rect key="frame" x="690" y="506" width="74" height="26"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES"/>
                        <buttonCell key="cell" type="push" title="Reload"
                                    bezelStyle="rounded" alignment="center"
                                    borderStyle="border" imageScaling="proportionallyDown" inset="2" id="71">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="reload:" target="-2" id="72"/>
                        </connections>
                    </button>

                    <!-- LEFT: package name list -->
                    <scrollView fixedFrame="YES" autohidesScrollers="YES"
                                horizontalLineScroll="17" horizontalPageScroll="10"
                                verticalLineScroll="17" verticalPageScroll="10"
                                hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO"
                                translatesAutoresizingMaskIntoConstraints="NO" id="8">
                        <rect key="frame" x="0" y="48" width="248" height="452"/>
                        <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                        <clipView key="contentView" id="9">
                            <rect key="frame" x="0" y="0" width="233" height="435"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                            <subviews>
                                <tableView verticalHuggingPriority="750"
                                           allowsExpansionToolTips="YES"
                                           columnAutoresizingStyle="lastColumnOnly"
                                           alternatingRowBackgroundColors="YES"
                                           selectionHighlightStyle="regular"
                                           multipleSelection="NO" autosaveColumns="NO"
                                           rowHeight="20" headerView="91" id="10">
                                    <rect key="frame" x="0.0" y="0.0" width="233" height="435"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <size key="intercellSpacing" width="3" height="2"/>
                                    <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog"/>
                                    <tableColumns>
                                        <tableColumn identifier="name" editable="NO"
                                                     width="233" minWidth="100" maxWidth="500" id="101">
                                            <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail"
                                                             borderStyle="border" alignment="left" title="Package">
                                                <font key="font" metaFont="smallSystemBold"/>
                                                <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog"/>
                                            </tableHeaderCell>
                                            <textFieldCell key="dataCell" scrollable="YES" lineBreakMode="truncatingTail"
                                                           selectable="YES" editable="NO" id="301">
                                                <font key="font" metaFont="system"/>
                                                <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog"/>
                                            </textFieldCell>
                                            <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" userResizable="YES"/>
                                        </tableColumn>
                                    </tableColumns>
                                    <connections>
                                        <outlet property="dataSource" destination="-2" id="11"/>
                                        <outlet property="delegate"   destination="-2" id="12"/>
                                    </connections>
                                </tableView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES"
                                  verticalHuggingPriority="750" horizontal="YES" id="13">
                            <rect key="frame" x="-100" y="-100" width="233" height="15"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <scroller key="verticalScroller" wantsLayer="YES"
                                  verticalHuggingPriority="750" horizontal="NO" id="14">
                            <rect key="frame" x="233" y="0.0" width="15" height="435"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <tableHeaderView key="headerView" id="91">
                            <rect key="frame" x="0.0" y="0.0" width="233" height="17"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </tableHeaderView>
                    </scrollView>

                    <!-- RIGHT: detail pane -->
                    <scrollView fixedFrame="YES" autohidesScrollers="YES"
                                horizontalLineScroll="10" horizontalPageScroll="10"
                                verticalLineScroll="10" verticalPageScroll="10"
                                hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO"
                                translatesAutoresizingMaskIntoConstraints="NO" id="80">
                        <rect key="frame" x="248" y="48" width="532" height="452"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <clipView key="contentView" id="81">
                            <rect key="frame" x="1" y="1" width="530" height="450"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                            <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            <subviews>
                                <textView editable="NO" selectable="YES" importsGraphics="NO"
                                          richText="YES" usesFontPanel="NO" allowsUndo="NO"
                                          verticallyResizable="YES" horizontallyResizable="NO"
                                          id="82">
                                    <rect key="frame" x="0.0" y="0.0" width="530" height="450"/>
                                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                                    <color key="textColor" name="textColor" catalog="System" colorSpace="catalog"/>
                                    <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                                    <size key="minSize" width="530" height="450"/>
                                    <size key="maxSize" width="530" height="10000000"/>
                                </textView>
                            </subviews>
                        </clipView>
                        <scroller key="horizontalScroller" hidden="YES" wantsLayer="YES"
                                  verticalHuggingPriority="750" horizontal="YES" id="83">
                            <rect key="frame" x="-100" y="-100" width="530" height="15"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                        <scroller key="verticalScroller" wantsLayer="YES"
                                  verticalHuggingPriority="750" horizontal="NO" id="84">
                            <rect key="frame" x="515" y="0.0" width="15" height="450"/>
                            <autoresizingMask key="autoresizingMask"/>
                        </scroller>
                    </scrollView>

                    <!-- Progress indicator -->
                    <progressIndicator verticalHuggingPriority="750" fixedFrame="YES"
                                       style="spinning" controlSize="small" hidden="YES"
                                       translatesAutoresizingMaskIntoConstraints="NO" id="50">
                        <rect key="frame" x="16" y="16" width="16" height="16"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    </progressIndicator>

                    <!-- Status label -->
                    <textField verticalHuggingPriority="750" fixedFrame="YES"
                               translatesAutoresizingMaskIntoConstraints="NO" id="60">
                        <rect key="frame" x="38" y="14" width="460" height="17"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
                        <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping"
                                       sendsActionOnEndEditing="YES" title="" id="61">
                            <font key="font" metaFont="smallSystem"/>
                            <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                            <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                        </textFieldCell>
                    </textField>

                    <!-- Install / Uninstall / Update button -->
                    <button verticalHuggingPriority="750" fixedFrame="YES"
                            translatesAutoresizingMaskIntoConstraints="NO" id="40">
                        <rect key="frame" x="648" y="8" width="116" height="32"/>
                        <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxY="YES"/>
                        <buttonCell key="cell" type="push" title="Install"
                                    bezelStyle="rounded" alignment="center"
                                    borderStyle="border" imageScaling="proportionallyDown" inset="2" id="41">
                            <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                            <font key="font" metaFont="system"/>
                        </buttonCell>
                        <connections>
                            <action selector="installOrUninstall:" target="-2" id="42"/>
                        </connections>
                    </button>

                </subviews>
            </view>
            <connections>
                <outlet property="delegate" destination="-2" id="26"/>
            </connections>
            <point key="canvasLocation" x="124" y="147"/>
        </window>
    </objects>
</document>
